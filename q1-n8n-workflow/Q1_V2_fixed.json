    {
      "parameters": {
        "jsCode": "const consultants = $input.all().map(item => item.json);\nconst enquiry = $('Validate LLM Output').item.json;\n\nconst combined = `${enquiry.role_sought || ''} ${enquiry.location || ''}`.toLowerCase();\n\nconst match = consultants.find(c =>\n  (c['Specialty Keywords'] || []).some(kw => combined.includes(kw.toLowerCase()))\n);\n\nreturn {\n  json: {\n    ...enquiry,\n    assigned_consultant: match ? match.Name : 'Unassigned - needs triage',\n    assigned_consultant_email: match ? match.Email : null,\n  }\n};\n"
      },
